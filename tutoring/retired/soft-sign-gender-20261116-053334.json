  "field": "Text",
  "old": "<b>piano</b><br><br><table style=\"margin: 0 auto; text-align: left; border-collapse: collapse;\"><tr><td style=\"padding: 2px 10px; vertical-align: top;\">1:</td><td style=\"padding: 2px 10px; vertical-align: top;\"><i>general term</i></td><td style=\"padding: 2px 10px; vertical-align: top;\">{{c1::фортепиа́но}}</td></tr><tr><td style=\"padding: 2px 10px; vertical-align: top;\">2:</td><td style=\"padding: 2px 10px; vertical-align: top;\"><i>upright</i></td><td style=\"padding: 2px 10px; vertical-align: top;\">{{c2::пиани́но}}</td></tr><tr><td style=\"padding: 2px 10px; vertical-align: top;\">3:</td><td style=\"padding: 2px 10px; vertical-align: top;\"><i>grand</i></td><td style=\"padding: 2px 10px; vertical-align: top;\">{{c3::роя́ль}}</td></tr></table>"
