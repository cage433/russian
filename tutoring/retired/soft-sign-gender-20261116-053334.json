 {
  "id": 1791237568426,
  "field": "Text",
  "old": "<b>producer</b><br><br><table style=\"margin: 0 auto; text-align: left; border-collapse: collapse;\"><tr><td style=\"padding: 2px 10px; vertical-align: top;\">1:</td><td style=\"padding: 2px 10px; vertical-align: top;\"><i>manufacturer (of goods)</i></td><td style=\"padding: 2px 10px; vertical-align: top;\">{{c1::производи́тель}}</td></tr><tr><td style=\"padding: 2px 10px; vertical-align: top;\">2:</td><td style=\"padding: 2px 10px; vertical-align: top;\"><i>in film, music, or TV</i></td><td style=\"padding: 2px 10px; vertical-align: top;\">{{c2::продю́сер}}</td></tr></table>"
 },
 {
  "id": 1791451292853,
  "field": "Text",
  "old": "<b>in-laws</b><br><br><table style=\"margin: 0 auto; text-align: left; border-collapse: collapse;\"><tr><td style=\"padding: 2px 10px; vertical-align: top;\">1:</td><td style=\"padding: 2px 10px; vertical-align: top;\"><i>mother-in-law (wife's mother)</i></td><td style=\"padding: 2px 10px; vertical-align: top;\">{{c1::тёща}}</td></tr><tr><td style=\"padding: 2px 10px; vertical-align: top;\">2:</td><td style=\"padding: 2px 10px; vertical-align: top;\"><i>father-in-law (wife's father)</i></td><td style=\"padding: 2px 10px; vertical-align: top;\">{{c2::тесть}}</td></tr><tr><td style=\"padding: 2px 10px; vertical-align: top;\">3:</td><td style=\"padding: 2px 10px; vertical-align: top;\"><i>mother-in-law (husband's mother)</i></td><td style=\"padding: 2px 10px; vertical-align: top;\">{{c3::свекро́вь (f)}}</td></tr><tr><td style=\"padding: 2px 10px; vertical-align: top;\">4:</td><td style=\"padding: 2px 10px; vertical-align: top;\"><i>father-in-law (husband's father)</i></td><td style=\"padding: 2px 10px; vertical-align: top;\">{{c4::свёкор}}</td></tr><tr><td style=\"padding: 2px 10px; vertical-align: top;\">5:</td><td style=\"padding: 2px 10px; vertical-align: top;\"><i>son-in-law; brother-in-law (sister's husband)</i></td><td style=\"padding: 2px 10px; vertical-align: top;\">{{c5::зять (m)}}</td></tr><tr><td style=\"padding: 2px 10px; vertical-align: top;\">6:</td><td style=\"padding: 2px 10px; vertical-align: top;\"><i>daughter-in-law (to the husband's parents)</i></td><td style=\"padding: 2px 10px; vertical-align: top;\">{{c6::сноха́}}</td></tr><tr><td style=\"padding: 2px 10px; vertical-align: top;\">7:</td><td style=\"padding: 2px 10px; vertical-align: top;\"><i>daughter-in-law; sister-in-law (brother's wife)</i></td><td style=\"padding: 2px 10px; vertical-align: top;\">{{c7::неве́стка}}</td></tr></table>"
 },
 {
  "id": 1793652927117,
  "field": "Text",
  "old": "<b>-польз- I</b> &nbsp;\"use, benefit\"<br><br><table style=\"margin: 0 auto; text-align: left; border-collapse: collapse;\"><tr><td style=\"padding: 2px 10px; vertical-align: top;\">to use, make use of (a phone, a service); to enjoy (popularity, rights)</td><td class=\"pc\" style=\"padding: 2px 10px; vertical-align: top;\">{{c1::—}}</td><td style=\"padding: 2px 10px; vertical-align: top;\">{{c1::по́льзоваться / воспо́льзоваться (+inst)}}</td><td class=\"pm\" style=\"padding: 2px 10px; vertical-align: top;\"><i>(plain)</i></td></tr><tr><td style=\"padding: 2px 10px; vertical-align: top;\">to use, utilise (something for a purpose)</td><td class=\"pc\" style=\"padding: 2px 10px; vertical-align: top;\">{{c2::ис-}}</td><td style=\"padding: 2px 10px; vertical-align: top;\">{{c2::испо́льзовать (i/p) (+a)}}</td><td class=\"pm\" style=\"padding: 2px 10px; vertical-align: top;\"><i>(idiomatic)</i></td></tr><tr><td style=\"padding: 2px 10px; vertical-align: top;\">to be used (passive)</td><td class=\"pc\" style=\"padding: 2px 10px; vertical-align: top;\">{{c3::ис- …-ся}}</td><td style=\"padding: 2px 10px; vertical-align: top;\">{{c3::испо́льзоваться}}</td><td class=\"pm\" style=\"padding: 2px 10px; vertical-align: top;\"><i>(idiomatic)</i></td></tr><tr><td style=\"padding: 2px 10px; vertical-align: top;\">utilisation, application (of resources, methods)</td><td class=\"pc\" style=\"padding: 2px 10px; vertical-align: top;\">{{c4::ис-}}</td><td style=\"padding: 2px 10px; vertical-align: top;\">{{c4::испо́льзование}}</td><td class=\"pm\" style=\"padding: 2px 10px; vertical-align: top;\"><i>(idiomatic)</i></td></tr><tr><td style=\"padding: 2px 10px; vertical-align: top;\">use (of a service), having the use of</td><td class=\"pc\" style=\"padding: 2px 10px; vertical-align: top;\">{{c5::—}}</td><td style=\"padding: 2px 10px; vertical-align: top;\">{{c5::по́льзование (+inst)}}</td><td class=\"pm\" style=\"padding: 2px 10px; vertical-align: top;\"><i>(plain)</i></td></tr><tr><td style=\"padding: 2px 10px; vertical-align: top;\">user</td><td class=\"pc\" style=\"padding: 2px 10px; vertical-align: top;\">{{c6::—}}</td><td style=\"padding: 2px 10px; vertical-align: top;\">{{c6::по́льзователь}}</td><td class=\"pm\" style=\"padding: 2px 10px; vertical-align: top;\"><i>(plain)</i></td></tr></table>"
 }
]