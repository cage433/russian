   "Conjugation": {
    "value": "<table><colgroup> <col span=\"1\" style=\"width: 30%\"> <col span=\"1\" style=\"width: 70%\"></colgroup><tbody><tr><td>1s </td><td><em>везу́</em></td></tr><tr><td>2s </td><td><em>везёшь</em></td></tr><tr><td>3p </td><td><em>везу́т</em></td></tr></tbody></table>",
    "order": 3
   },
   "Definitions": {
    "value": "<ul><li>to convey, to carry (by vehicle), to deliver, to transport</li><li>(impersonal) to be lucky, to have luck, to work out for, to succeed, to be successful [with dative ‘for someone’ and infinitive ‘to do something’]<br></li></ul>",
    "order": 4
   },
   "Examples": {
    "value": "<p style=\"text-align:left\"><strong>Examples:</strong></p><ul><li><em>Па́ше и Са́ше не везёт сего́дня</em> - Pasha and Sasha are having no luck today.</li><li><em>дурака́м всегда́ везёт</em> - fools are always lucky</li></ul>",
    "order": 5
   },
   "Correspondents": {
    "value": "(perf. <em>повезти́</em>)",
    "order": 6
   },
